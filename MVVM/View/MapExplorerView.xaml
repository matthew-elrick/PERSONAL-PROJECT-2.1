<UserControl x:Class="PERSONAL_PROJECT_2.MVVM.View.MapExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PERSONAL_PROJECT_2.MVVM.View"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080">
    <UserControl.Resources>
        <Style x:Key="CoolSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#30303D"/>
            <Setter Property="Foreground" Value="#8B5CF6"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">

                        <Grid>
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center"
                                   Focusable="False">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  BorderThickness="0"
                                                  Background="#212D40"
                                                  Height="5"
                                                  VerticalAlignment="Center"/>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  BorderThickness="0"
                                                  Background="#30303D"
                                                  Height="5"
                                                  VerticalAlignment="Center"/>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="16"
                                           Height="16"
                                           Background="White"
                                           BorderThickness="0"> 

                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Width="26"
                                                             Height="26"
                                                             Fill="#8B5CF6"
                                                             Opacity="0.18"/>

                                                    <Ellipse Width="14"
                                                             Height="14"
                                                             Fill="White">

                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="8"
                                                                              ShadowDepth="0"
                                                                              Opacity="0.7"/>
                                                        </Ellipse.Effect>

                                                    </Ellipse>

                                                </Grid>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter Property="Opacity"
                                                                Value="0.85"/>
                                                    </Trigger>

                                                    <Trigger Property="IsDragging"
                                                             Value="True">
                                                        <Setter Property="Opacity"
                                                                Value="0.7"/>
                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Thumb.Template>

                                    </Thumb>
                                </Track.Thumb>

                            </Track>

                        </Grid>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <mapsui:MapControl x:Name="mapControl" />

        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="20"
                    Width="45">

            <Button Content="+"
                    Height="45"
                    FontSize="24"
                    Background="#212D40"
                    Foreground="White"
                    BorderThickness="0"
                    Click="ZoomIn_Click"
                    Margin="0,0,0,2">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#364156"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="−"
                    Height="45"
                    FontSize="24"
                    Background="#212D40"
                    Foreground="White"
                    BorderThickness="0"
                    Click="ZoomOut_Click"
                    Margin="0,2,0,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#364156"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
        
        <!--<Slider x:Name="groupDistanceSlider"
                Minimum="1"
                Maximum="20"
                Width="150"
                Height="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20,0,0,20"
                Value="{Binding GroupDistance, Mode=TwoWay}"/>-->
        <Slider x:Name="groupDistanceSlider"
                Style="{StaticResource CoolSlider}"
                Minimum="1"
                Maximum="20"
                Width="150"
                Height="28"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20,0,0,20"
                Value="{Binding GroupDistance, Mode=TwoWay}"/>

        <Border x:Name="photoPopup"
                Width="300"
                Height="320"
                Background="#30FFFFFF"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Panel.ZIndex="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="popupLocation"
                           Grid.Row="0"
                           Text="Loading location..."
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           Margin="0,0,0,8"/>

                <Image x:Name="popupImage"
                       Grid.Row="1"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       SnapsToDevicePixels="True"/>

                <Grid Grid.Row="2">
                    <Button x:Name="previousPhotoButton"
                            Background="#AA000000"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="PreviousPhoto_Click">

                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius"
                                Value="7"/>
                            </Style>
                        </Button.Resources>

                        <TextBlock Text="&lt;"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <Border Background="#AA000000"
                            CornerRadius="10"
                            Padding="8,3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <TextBlock x:Name="photoCounter"
                                   Foreground="White"
                                   Text="1 / 1"/>
                    </Border>

                    <Button x:Name="nextPhotoButton"
                            Background="#AA000000"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="NextPhoto_Click">

                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius"
                                        Value="7"/>
                            </Style>
                        </Button.Resources>

                        <TextBlock Text="&gt;"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                </Grid>

            </Grid>

        </Border>
    </Grid>
</UserControl>
