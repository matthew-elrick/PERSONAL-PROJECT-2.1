<UserControl x:Class="PERSONAL_PROJECT_2.MVVM.View.MapExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PERSONAL_PROJECT_2.MVVM.View"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080">
    <Grid>
        <mapsui:MapControl x:Name="mapControl" />
        
        <Border x:Name="photoPopup"
                Width="300"
                Height="320"
                Background="White"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Panel.ZIndex="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="popupLocation"
                           Grid.Row="0"
                           Text="Loading location..."
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <Image x:Name="popupImage"
                       Grid.Row="1"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       SnapsToDevicePixels="True"/>

                <Grid Grid.Row="2">
                    <Button x:Name="previousPhotoButton"
                            Background="#AA000000"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="PreviousPhoto_Click">

                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius"
                                Value="7"/>
                            </Style>
                        </Button.Resources>

                        <TextBlock Text="&lt;"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <Border Background="#AA000000"
                            CornerRadius="10"
                            Padding="8,3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <TextBlock x:Name="photoCounter"
                                   Foreground="White"
                                   Text="1 / 1"/>
                    </Border>

                    <Button x:Name="nextPhotoButton"
                            Background="#AA000000"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="NextPhoto_Click">

                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius"
                                        Value="7"/>
                            </Style>
                        </Button.Resources>

                        <TextBlock Text="&gt;"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                </Grid>

            </Grid>

        </Border>
    </Grid>
</UserControl>
