<UserControl x:Class="PERSONAL_PROJECT_2.MVVM.View.UploadPhotoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PERSONAL_PROJECT_2.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080">
    <Grid Width="1080"> <!---850-->
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/> <!--Header-->
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#91493B" Offset="0"/>
                            <GradientStop Color="#C78477" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Style>

        <TextBlock FontSize="30"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="White"
                   Text="Upload Photos"/>

        <Separator VerticalAlignment="Bottom"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <StackPanel VerticalAlignment="Center">
                <Grid>
                    <Rectangle AllowDrop="True"
                           Drop="Rectangle_Drop"
                           Fill="WhiteSmoke"
                           RadiusX="10"
                           RadiusY="10"
                           StrokeDashArray="10"
                           StrokeThickness="2"
                           StrokeDashCap="Round"
                           Stroke="Black"
                           Height="300"
                           Width="300"/>
                
                <!--Long ass data thing is just the cloud/upload symbol just use a photo-->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Path Data="M16 7C13.351563 7 11.050781 8.238281 9.40625
                                10.0625C9.269531 10.046875 9.148438 10 9 10C6.800781 10 5
                                11.800781 5 14C3.269531 15.054688 2 16.835938 2 19C2
                                22.300781 4.699219 25 8 25L13 25L13 23L8 23C5.78125 23 4
                                21.21875 4 19C4 17.339844 5.007813 15.921875 6.4375
                                15.3125L7.125 15.03125L7.03125 14.28125C7.011719 14.117188 7
                                14.023438 7 14C7 12.882813 7.882813 12 9 12C9.140625 12
                                9.296875 12.019531 9.46875 12.0625L10.09375
                                12.21875L10.46875 11.71875C11.75 10.074219 13.75 9 16
                                9C19.277344 9 22.011719 11.253906 22.78125 14.28125L22.9687
                                15.0625L23.8125 15.03125C24.023438 15.019531 24.070313 15
                                24 15C26.21875 15 28 16.78125 28 19C28 21.21875 26.21875 23
                                24 23L19 23L19 25L24 25C27.300781 25 30 22.300781 30 19C30
                                15.84375 27.511719 13.316406 24.40625 13.09375C23.183594
                                9.574219 19.925781 7 16 7 Z M 16 15L12 19L15 19L15 27L17
                                27L17 19L20 19Z"
                          Fill="Gray"
                          Stretch="Uniform"
                          Height="50"/>
                        <TextBlock Text="Drop Photos to Upload"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
                <Button Background="#364156"
                        BorderThickness="0"
                        Content="Choose Photo"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Height="50"
                        Width="150"
                        Margin="0,30,0,0"
                        Click="Button_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#212D40"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
                    <ScrollViewer Grid.Column="1"
                          Margin="0,45"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <ItemsControl x:Name="UploadingFilesList" Margin="0,0,38,0">
                        
                    </ItemsControl>
                </Grid>
                
            </ScrollViewer>
        </Grid>
          
    </Grid>
</UserControl>
